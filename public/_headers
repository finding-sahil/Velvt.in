# Cloudflare Edge & Static Headers for VELVT.in
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  X-DNS-Prefetch-Control: on

# Next.js Immutable Bundles (1-Year Edge Cache)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Web Fonts (1-Year Edge Cache)
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Static Brand Assets & Favicons (30-Day Edge Cache)
/icon.png
  Cache-Control: public, max-age=2592000, s-maxage=2592000, immutable

/apple-icon.png
  Cache-Control: public, max-age=2592000, s-maxage=2592000, immutable

/favicon.ico
  Cache-Control: public, max-age=2592000, s-maxage=2592000, immutable

# Gallery & Events Public Media (7-Day Cache with Background SWR)
/gallery/*
  Cache-Control: public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

/events/*
  Cache-Control: public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *
